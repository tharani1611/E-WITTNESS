# =============================================================================
# E-WITNESS — Sanitized Environment Configuration Template (.env.example)
# =============================================================================
# SECURITY WARNING:
# 1. Copy this file to `.env` for local development ONLY.
# 2. NEVER commit `.env` or any file containing real secrets to version control.
# 3. Placeholder values below are strictly for local development reference.
#    Production mode (`ENVIRONMENT=production`) enforces strict validation and
#    will refuse to start if placeholder secrets, weak keys, or insecure URLs
#    are supplied.
# =============================================================================

# -----------------------------------------------------------------------------
# Application & Runtime Environment
# -----------------------------------------------------------------------------
APP_NAME="E-WITNESS"
APP_VERSION="0.1.0"
# Allowed values: development | testing | production
ENVIRONMENT="development"
DEBUG=false
API_V1_PREFIX="/api/v1"

# -----------------------------------------------------------------------------
# Logging & Redaction
# -----------------------------------------------------------------------------
# Allowed values: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL="INFO"
# Allowed values: json | console
LOG_FORMAT="json"
# Must remain true in production to prevent credential/token leakage
LOG_REDACT_SENSITIVE=true

# -----------------------------------------------------------------------------
# CORS Security
# -----------------------------------------------------------------------------
# Comma-separated or JSON list of allowed origins.
# Wildcard (*) and plain http:// origins are rejected in production.
CORS_ALLOWED_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'

# -----------------------------------------------------------------------------
# Primary Relational Database (PostgreSQL Async)
# -----------------------------------------------------------------------------
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL="postgresql+asyncpg://ewitness_dev_user:REPLACE_WITH_LOCAL_DB_PASSWORD@localhost:5432/ewitness_dev"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30.0
DB_CONNECT_TIMEOUT_SECONDS=10.0
DB_COMMAND_TIMEOUT_SECONDS=60.0
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_PRE_PING=true
DB_ECHO=false

# -----------------------------------------------------------------------------
# Cache & Coordination (Redis)
# -----------------------------------------------------------------------------
# Format: redis://[:password]@host:port/db or rediss://[:password]@host:port/db (TLS required in production)
REDIS_URL="redis://localhost:6379/0"
REDIS_MAX_CONNECTIONS=20
REDIS_TIMEOUT_SECONDS=5.0

# -----------------------------------------------------------------------------
# Evidence Object Storage (S3-Compatible)
# -----------------------------------------------------------------------------
STORAGE_ENDPOINT_URL="https://s3.localhost.localdomain:9000"
STORAGE_BUCKET_NAME="ewitness-evidence-dev"
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY="REPLACE_WITH_LOCAL_STORAGE_ACCESS_KEY"
STORAGE_SECRET_KEY="REPLACE_WITH_LOCAL_STORAGE_SECRET_KEY"
# SSL is mandatory in production; TLS verification may NEVER be disabled.
STORAGE_USE_SSL=true
STORAGE_VERIFY_TLS=true
STORAGE_TIMEOUT_SECONDS=30.0

# -----------------------------------------------------------------------------
# Authentication & Token Signing
# -----------------------------------------------------------------------------
# Generate a strong key via: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Minimum 32 characters with high entropy required.
AUTH_SECRET_KEY="REPLACE_WITH_HIGH_ENTROPY_SECRET_KEY_MIN_32_CHARS"
# Allowed values: HS256 | HS384 | HS512 | RS256 | ES256 ('none' is strictly forbidden)
AUTH_ALGORITHM="HS256"
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_ISSUER="ewitness-api"
AUTH_AUDIENCE="ewitness-client"

# -----------------------------------------------------------------------------
# Isolated AI Processing Boundary
# -----------------------------------------------------------------------------
AI_ENABLED=false
# Allowed values: disabled | openai | anthropic | gemini | local
AI_PROVIDER="disabled"
AI_MODEL_NAME=""
AI_API_KEY=""
AI_BASE_URL=""
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.1
AI_REQUEST_TIMEOUT_SECONDS=45.0
# Must remain false: E-WITNESS never executes external AI calls during startup.
AI_CONNECT_ON_STARTUP=false

# -----------------------------------------------------------------------------
# Request, Upload, and External Service Guardrails
# -----------------------------------------------------------------------------
# Maximum general HTTP request body size in bytes (default: 2 MB)
MAX_REQUEST_BODY_BYTES=2097152
# Maximum single evidence file upload size in bytes (default: 50 MB)
MAX_EVIDENCE_FILE_BYTES=52428800
# Streaming upload chunk size in bytes (default: 1 MB)
UPLOAD_CHUNK_SIZE_BYTES=1048576
# Allowed MIME types for evidence uploads (JSON array)
ALLOWED_EVIDENCE_MIME_TYPES='["application/pdf","image/jpeg","image/png","image/webp","audio/mpeg","audio/wav","video/mp4","text/plain"]'
# Default outbound HTTP client timeout in seconds
HTTP_TIMEOUT_SECONDS=15.0
